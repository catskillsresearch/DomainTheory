#!/usr/bin/env bash
# Full local rebuild: notes → arxiv.md → scratch arxiv.tex → arxiv.pdf (+ view.pdf, dist zip).
# arxiv.tex and LaTeX aux files are ephemeral (see .gitignore); only arxiv.pdf is kept at repo root.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

BUILD="${ROOT}/.build/aa"
PDF="${ROOT}/arxiv.pdf"
VIEW="${ROOT}/view.pdf"

# shellcheck source=scripts/pdf_checks.sh
source "${ROOT}/scripts/pdf_checks.sh"

usage() {
  cat <<'EOF'
Usage: ./aa [options]

  Regenerate dependency mermaid diagrams, flatten the note tree, build listings
  and figures, compile arxiv.pdf in a scratch directory, copy view.pdf, package
  dist/arxiv_submit.zip, then remove arxiv.tex and other LaTeX scratch files.

Options:
  --skip-mermaid   Skip scripts/generate_dependency_mermaid.py --write
  --skip-zip       Skip dist/arxiv_submit.zip
  --keep-scratch   Keep .build/aa/ on success (for debugging failed pdflatex)
EOF
}

SKIP_MERMAID=0
SKIP_ZIP=0
KEEP_SCRATCH=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-mermaid) SKIP_MERMAID=1 ;;
    --skip-zip) SKIP_ZIP=1 ;;
    --keep-scratch) KEEP_SCRATCH=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

rm -rf "$BUILD"
mkdir -p "$BUILD"

cleanup() {
  rm -f "${ROOT}/arxiv.tex"
  rm -f "${ROOT}"/arxiv.{aux,log,out,toc,lof,fls,fdb_latexmk,synctex.gz}
  if [[ "$KEEP_SCRATCH" -eq 0 ]]; then
    rm -rf "$BUILD"
  fi
}

if [[ "$SKIP_MERMAID" -eq 0 ]]; then
  echo "==> Regenerating dependency mermaid diagrams"
  python3 scripts/generate_dependency_mermaid.py --write
fi

echo "==> Refreshing notes, flattening DomainTheory.md → arxiv.md, building listings + figures"
bash scripts/build_arxiv_tex.sh

if [[ ! -f "${ROOT}/arxiv.tex" ]]; then
  echo "error: build_arxiv_tex.sh did not produce arxiv.tex" >&2
  exit 1
fi

mv "${ROOT}/arxiv.tex" "${BUILD}/arxiv.tex"
ln -sf "${ROOT}/figures" "${BUILD}/figures"
ln -sf "${ROOT}/lean-listings" "${BUILD}/lean-listings"
# Local class/style files live at repo root; -cd compile cwd is .build/aa/
export TEXINPUTS="${ROOT}//:${TEXINPUTS:-}"

rm -f "$PDF" "$VIEW"

echo "==> Compiling arxiv.pdf (scratch tex: .build/aa/arxiv.tex)"
latexmk -C -cd "$BUILD/arxiv.tex" >/dev/null 2>&1 || true
if ! latexmk -pdf -interaction=nonstopmode -halt-on-error -cd "$BUILD/arxiv.tex"; then
  echo "pdflatex failed; log tail:" >&2
  tail -n 50 "${BUILD}/arxiv.log" >&2 || true
  echo "scratch kept at ${BUILD}/ (use --keep-scratch or fix and re-run)" >&2
  KEEP_SCRATCH=1
  exit 1
fi

if [[ ! -f "${BUILD}/arxiv.pdf" ]]; then
  echo "error: missing ${BUILD}/arxiv.pdf after latexmk" >&2
  KEEP_SCRATCH=1
  exit 1
fi

cp -f "${BUILD}/arxiv.pdf" "$PDF"
cp -f "$PDF" "$VIEW"
echo "wrote arxiv.pdf ($(du -h "$PDF" | cut -f1), $(pdfinfo "$PDF" | awk '/Pages:/ {print $2}') pages)"
echo "wrote view.pdf"

echo "==> Font embedding check"
check_pdf_fonts_embedded "$PDF" "arxiv.pdf"

if [[ "$SKIP_ZIP" -eq 0 ]]; then
  echo "==> Packaging arXiv submission zip (temporary arxiv.tex at repo root for zip only)"
  cp -f "${BUILD}/arxiv.tex" "${ROOT}/arxiv.tex"
  bash scripts/package_arxiv_submit.sh --skip-tex-build
fi

cleanup
echo "==> Done (scratch tex removed)"
