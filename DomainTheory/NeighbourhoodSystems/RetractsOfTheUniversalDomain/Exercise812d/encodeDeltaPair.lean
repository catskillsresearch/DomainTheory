open NeighborhoodSystem Domain.Recursive ApproximableMap Exercise718

def encodeDeltaPair (δ : ℕ → Bool × Bool) : ℕ → ℕ
  | 0 => 0
  | n + 1 => encodeDeltaPair δ n +
      ((if (δ n).1 then 1 else 0) + (if (δ n).2 then 2 else 0)) * 4 ^ n

