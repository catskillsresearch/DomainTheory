/-ai
A set of natural numbers lies in the algebra generated by the generators if and only if it is the evaluation set of some formula.

In one direction, induct on the generation. A generator is the evaluation of the corresponding variable, the whole set is the evaluation of truth, and an intersection, union, or complement is the evaluation of the conjunction, disjunction, or negation of the formulas given by the inductive hypotheses. In the other direction, induct on the formula. A variable is a generator, falsehood is the complement of the whole set, truth is the whole set, and a negation, conjunction, or disjunction is the complement, intersection, or union of the generated sets given by the inductive hypotheses.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b.Basic

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems


/-- **`evalSet`'s range is exactly `GeneratedBy generator`** — the algebra generated by `generator`
(`Exercise813a.lean`) is precisely "the Boolean combinations expressible as a `Formula`." -/
theorem generatedBy_iff_exists_evalSet {X : Set ℕ} :
    GeneratedBy generator X ↔ ∃ φ : Formula, evalSet φ = X := by
  constructor
  · intro h
    induction h with
    | of i => exact ⟨.var i, rfl⟩
    | univ => exact ⟨.top, rfl⟩
    | @inter X Y _ _ ih1 ih2 =>
      obtain ⟨φ, rfl⟩ := ih1; obtain ⟨ψ, rfl⟩ := ih2
      exact ⟨.and φ ψ, rfl⟩
    | @union X Y _ _ ih1 ih2 =>
      obtain ⟨φ, rfl⟩ := ih1; obtain ⟨ψ, rfl⟩ := ih2
      exact ⟨.or φ ψ, rfl⟩
    | @compl X _ ih =>
      obtain ⟨φ, rfl⟩ := ih
      exact ⟨.neg φ, rfl⟩
  · rintro ⟨φ, rfl⟩
    induction φ with
    | var i => exact GeneratedBy.of i
    | bot => simpa [evalSet] using GeneratedBy.univ.compl
    | top => exact GeneratedBy.univ
    | neg φ ih => exact ih.compl
    | and φ ψ ihφ ihψ => exact ihφ.inter ihψ
    | or φ ψ ihφ ihψ => exact ihφ.union ihψ

end DomainTheory.NeighbourhoodSystems
