/-ai
If every member of a family of sets is generated by a sequence of sets, then every member of the dual family is generated by that sequence.

Simplifying dual membership, the complement lies in the original family and so is generated, and the complement of that generated set is generated.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b
public import Mathlib.Topology.Constructions
import all Mathlib.Topology.Constructions
public import Mathlib.Topology.Compactness.Compact
import all Mathlib.Topology.Compactness.Compact
public import Mathlib.Topology.Clopen
import all Mathlib.Topology.Clopen
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.Basic

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems


/-- Dualizing preserves membership in the algebra generated by `g` (using that `GeneratedBy g` is
closed under `compl`). -/
theorem generatedBy_of_mem_dualFilter {α : Type*} {g : ℕ → Set α} {x : Set (Set α)}
    (hx : ∀ Y ∈ x, GeneratedBy g Y) {Y : Set α} (hY : Y ∈ dualFilter x) : GeneratedBy g Y := by
  simpa using (hx _ hY).compl

end DomainTheory.NeighbourhoodSystems
