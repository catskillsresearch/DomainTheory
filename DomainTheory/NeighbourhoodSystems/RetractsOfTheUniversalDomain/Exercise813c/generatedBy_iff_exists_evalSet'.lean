/-ai
A set of points of Cantor space is generated by the coordinate sets if and only if it is the Cantor-space evaluation of some formula.

In one direction, induct on the generation. A coordinate set is the evaluation of the corresponding variable, the whole space is the evaluation of truth, and an intersection, union, or complement is the evaluation of the conjunction, disjunction, or negation of the formulas given by the inductive hypotheses. In the other direction, induct on the formula. A variable is a generator, falsehood is the complement of the whole space, truth is the whole space, and a negation, conjunction, or disjunction is the complement, intersection, or union of the generated sets given by the inductive hypotheses.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b
public import Mathlib.Topology.Constructions
import all Mathlib.Topology.Constructions
public import Mathlib.Topology.Compactness.Compact
import all Mathlib.Topology.Compactness.Compact
public import Mathlib.Topology.Clopen
import all Mathlib.Topology.Clopen
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.genPoint
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.mem_genPoint
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.mem_box
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.evalSet'

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b.generatedBy_iff_exists_evalSet
@[expose] public section

namespace DomainTheory.NeighbourhoodSystems

theorem generatedBy_iff_exists_evalSet' {Y : Set (ℕ → Bool)} :
    GeneratedBy genPoint Y ↔ ∃ φ : Formula, evalSet' φ = Y := by
  constructor
  · intro h
    induction h with
    | of i => exact ⟨.var i, rfl⟩
    | univ => exact ⟨.top, rfl⟩
    | @inter X Y _ _ ih1 ih2 =>
      obtain ⟨φ, rfl⟩ := ih1; obtain ⟨ψ, rfl⟩ := ih2
      exact ⟨.and φ ψ, rfl⟩
    | @union X Y _ _ ih1 ih2 =>
      obtain ⟨φ, rfl⟩ := ih1; obtain ⟨ψ, rfl⟩ := ih2
      exact ⟨.or φ ψ, rfl⟩
    | @compl X _ ih =>
      obtain ⟨φ, rfl⟩ := ih
      exact ⟨.neg φ, rfl⟩
  · rintro ⟨φ, rfl⟩
    induction φ with
    | var i => exact GeneratedBy.of i
    | bot => simpa [evalSet'] using GeneratedBy.univ.compl
    | top => exact GeneratedBy.univ
    | neg φ ih => exact ih.compl
    | and φ ψ ihφ ihψ => exact ihφ.inter ihψ
    | or φ ψ ihφ ihψ => exact ihφ.union ihψ

end DomainTheory.NeighbourhoodSystems
