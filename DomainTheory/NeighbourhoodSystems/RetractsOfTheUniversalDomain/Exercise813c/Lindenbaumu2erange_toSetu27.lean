/-ai
The range of the map from the Lindenbaum algebra to sets of points of Cantor space is exactly the algebra generated by the coordinate sets.

Extending a set, membership in the range and generation are rewritten as the existence of a class and of a formula. Induction on a quotient class produces a formula, and the class of a formula is a preimage of its Cantor-space evaluation.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b
public import Mathlib.Topology.Constructions
import all Mathlib.Topology.Constructions
public import Mathlib.Topology.Compactness.Compact
import all Mathlib.Topology.Compactness.Compact
public import Mathlib.Topology.Clopen
import all Mathlib.Topology.Clopen
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.Basic

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems

















theorem Lindenbaum.range_toSet' :
    Set.range Lindenbaum.toSet' = {Y | GeneratedBy genPoint Y} := by
  ext Y
  simp only [Set.mem_range, Set.mem_ofPred_eq, generatedBy_iff_exists_evalSet']
  constructor
  · rintro ⟨x, rfl⟩
    induction x using Quotient.ind with
    | _ φ => exact ⟨φ, rfl⟩
  · rintro ⟨φ, rfl⟩
    exact ⟨⟦φ⟧, rfl⟩

end DomainTheory.NeighbourhoodSystems
