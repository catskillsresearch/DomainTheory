/-ai
A set of points of Cantor space is open if and only if it is a union of sets generated by the coordinate sets.

If the set is open, take all generated sets contained in it. A point of the open set lies in a box obtained from the product characterization of openness: the point lies in the box pinning the supplied coordinates to its own values, that box is generated, and a point of the box agrees with the original point on those coordinates, so the product constraint puts it in the open set. A point of any generated subset in the family lies in the open set by the containment. Conversely, each generated set is clopen and hence open, and a union of those opens is open.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813b
public import Mathlib.Topology.Constructions
public import Mathlib.Topology.Compactness.Compact
public import Mathlib.Topology.Clopen
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.Basic
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.generatedBy_genPoint_isClopen
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.self_mem_box
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813c.generatedBy_genPoint_box

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems


/-- Immediate corollary: **opens** (not just clopens) of Cantor space are exactly unions of
`GeneratedBy genPoint` clopens — the "topological basis" fact underlying the scoping row's
candidate `(ii)`. -/
theorem isOpen_iff_exists_iUnion_generatedBy {O : Set (ℕ → Bool)} :
    IsOpen O ↔ ∃ (S : Set (Set (ℕ → Bool))), (∀ Y ∈ S, GeneratedBy genPoint Y) ∧ O = ⋃ Y ∈ S, Y := by
  constructor
  · intro hO
    refine ⟨{Y | GeneratedBy genPoint Y ∧ Y ⊆ O}, fun Y hY => hY.1, ?_⟩
    ext x
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq]
    constructor
    · intro hx
      obtain ⟨I, u, hu, hIu⟩ := isOpen_pi_iff.mp hO x hx
      have hxbox : x ∈ box I x := self_mem_box I x
      exact ⟨box I x, ⟨generatedBy_genPoint_box I x,
        fun y hy => hIu fun i hi => by rw [hy i hi]; exact (hu i hi).2⟩, hxbox⟩
    · rintro ⟨Y, ⟨_, hYO⟩, hxY⟩
      exact hYO hxY
  · rintro ⟨S, hS, rfl⟩
    exact isOpen_biUnion fun Y hY => (generatedBy_genPoint_isClopen (hS Y hY)).isOpen

end DomainTheory.NeighbourhoodSystems
