/-ai
The embedded neighbourhood system consists of the sets equal to some stage of the embedded sequence. Its master neighbourhood is the master neighbourhood of U, which is nonempty and equals the embedded set of index zero. Every embedded set is contained in that master neighbourhood. If an embedded set is contained in the intersection of two embedded sets, the transferred inclusions give two inclusions of enumerated neighbourhoods, the intersection law of D supplies a witnessed intersection, and the existence of an intersection index returns that equation as an equality of embedded sets.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88.Basic
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88.splitChoice_isSplitSpec
public import DomainTheory.NeighbourhoodSystems.DomainEquations.Definition610
public import DomainTheory.NeighbourhoodSystems.DomainEquations.Lemma615
public import Mathlib.Basic.Countable.Defs
import all Mathlib.Basic.Countable.Defs
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.mem_idxSet
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.D_mem_e
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.Yidx
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.Yidx_zero
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.Yidx_subset_master
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.embed_subset_iff
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Theorem88a.exists_inter_index_of_dmem

public import DomainTheory.NeighbourhoodSystems.DomainEquations.Lemma615.Subsystemu2etrianglelefteq
@[expose] public section

set_option linter.unusedSectionVars false

namespace DomainTheory.NeighbourhoodSystems

open NeighborhoodSystem

variable {α : Type*}

section Subsystem

variable (D : NeighborhoodSystem α) (e : ℕ → Set α)
  (hcover : ∀ S, D.mem S ↔ ∃ n, S = e n) (he0 : e 0 = D.master)

/-- **`D'`**: the neighbourhood system generated by `{Yidx e n ∣ n ∈ ℕ}`. Its `inter_mem` axiom
transfers *directly* from `D`'s own `inter_mem`: a witness `X k ⊆ X i ∩ X j` on the `D'`-side pulls
back (`embed_subset_iff`) to a witness `e k ⊆ e i ∩ e j` on the `D`-side, so `D`'s own axiom
supplies `e m = e i ∩ e j` for some `m`, and `transfer_inter_eq_iff` pushes this equation back
across to `Yidx e i ∩ Yidx e j = Yidx e m`. -/
noncomputable def DprimeU : NeighborhoodSystem ℚ where
  mem Y := ∃ n, Y = Yidx e n
  master := U.master
  master_nonempty := U.master_nonempty
  master_mem := ⟨0, (Yidx_zero D e hcover he0).symm⟩
  sub_master := by rintro Y ⟨n, rfl⟩; exact Yidx_subset_master e n
  inter_mem := by
    rintro X Y Z ⟨i, rfl⟩ ⟨j, rfl⟩ ⟨k, rfl⟩ hZsub
    have h1 : e k ⊆ e i := (embed_subset_iff e k i).mpr (hZsub.trans Set.inter_subset_left)
    have h2 : e k ⊆ e j := (embed_subset_iff e k j).mpr (hZsub.trans Set.inter_subset_right)
    obtain ⟨m, -, hYeq⟩ := exists_inter_index_of_dmem D e hcover
      (D.inter_mem (D_mem_e D e hcover i) (D_mem_e D e hcover j) (D_mem_e D e hcover k)
        (Set.subset_inter h1 h2))
    exact ⟨m, hYeq⟩

end Subsystem

end DomainTheory.NeighbourhoodSystems
