module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise812
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise812g4
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.Basic
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.V_mem_generator
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.V_compl_mem

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems

open NeighborhoodSystem


/-- **Soundness**: everything generated by `generator` is either empty or a genuine
`V`-neighbourhood. -/
theorem generatedBy_generator_imp {X : Set ℕ} (h : GeneratedBy generator X) :
    X = ∅ ∨ V.mem X := by
  induction h with
  | of i => exact Or.inr (V_mem_generator i)
  | univ => exact Or.inr V.master_mem
  | @inter X Y _ _ ih1 ih2 =>
    rcases ih1 with rfl | hX
    · exact Or.inl (Set.empty_inter Y)
    rcases ih2 with rfl | hY
    · exact Or.inl (Set.inter_empty X)
    obtain ⟨k₁, m₁, rfl, -⟩ := hX
    obtain ⟨k₂, m₂, rfl, -⟩ := hY
    rw [levelSet.inter]
    rcases (levelSet _ _).eq_empty_or_nonempty with h | h
    · exact Or.inl h
    · exact Or.inr ⟨_, _, rfl, h⟩
  | union _ _ ih1 ih2 => exact V_union_mem ih1 ih2
  | @compl X _ ih =>
    rcases ih with rfl | hX
    · simp only [Set.compl_empty]
      exact Or.inr V.master_mem
    · exact V_compl_mem hX

end DomainTheory.NeighbourhoodSystems
