/-ai
A set is a V-neighbourhood if and only if it is generated by the generators and is nonempty.

A neighbourhood is a nonempty level set, and every level set is generated. A generated nonempty set cannot be the empty alternative of the soundness dichotomy, so it is a neighbourhood.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise812
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise812g4
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.Basic
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.generatedBy_generator_imp
public import DomainTheory.NeighbourhoodSystems.RetractsOfTheUniversalDomain.Exercise813a.generatedBy_levelSet

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems

open NeighborhoodSystem











/-- **`V.mem` is *exactly* "non-empty and generated by `generator`"** — soundness
(`generatedBy_generator_imp`) plus completeness (`generatedBy_levelSet`). Since `V.Element`'s
defining conditions (`Basic.lean`'s `Element`: upward-closed, finite-meet-closed, contains the
top, and — because `V.mem` excludes `∅` — never contains the bottom) are precisely "proper filter
of `{X | GeneratedBy generator X}`", this makes **`V.Element` *by definition* the domain of proper
filters of the Boolean algebra generated by `generator`**. -/
theorem V_mem_iff_generatedBy {X : Set ℕ} : V.mem X ↔ GeneratedBy generator X ∧ X.Nonempty := by
  constructor
  · rintro ⟨k, m, rfl, hne⟩
    exact ⟨generatedBy_levelSet k m, hne⟩
  · rintro ⟨hgen, hne⟩
    exact (generatedBy_generator_imp hgen).resolve_left hne.ne_empty

end DomainTheory.NeighbourhoodSystems
