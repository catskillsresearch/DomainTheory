  @Eq (@DomainTheory.NeighbourhoodSystems.ApproximableMap α α E E)
    (@DomainTheory.NeighbourhoodSystems.translateAbs α E a b
      (@DomainTheory.NeighbourhoodSystems.ApproximableMap.idMap α E))
