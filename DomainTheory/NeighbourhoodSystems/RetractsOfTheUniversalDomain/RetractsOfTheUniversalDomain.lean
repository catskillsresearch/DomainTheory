theorem le_one {bx : ℕ} (hbx : bx ≤ 1) (n i : ℕ) :
    yPseqAtomJunk P₀ P₁ hDiff0 hDiff1 splitX hSplitX splitY hSplitY n i bx ≤ 1 := by
