section UniversalSubsystem

section TreeVal

variable (r : ℕ → ℕ)

theorem TreeVal_eq_QFuel {c fuel : ℕ} (h : c < fuel) : TreeVal r c = QFuel r fuel c :=
  QFuel_stable r c (c + 1) fuel (Nat.lt_succ_self c) h

