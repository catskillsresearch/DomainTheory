section AtomCode

variable {E : NeighborhoodSystem α} (Q : ComputablePresentation E)

/-- Extract the current depth `y` from a packed step-input `w = pair k (pair y state)`. -/
def wY (w : ℕ) : ℕ := w.unpair.2.unpair.1

