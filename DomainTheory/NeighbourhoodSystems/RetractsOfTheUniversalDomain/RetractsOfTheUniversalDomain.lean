section Algebraic

variable {γ : Type u} {V : NeighborhoodSystem γ}


theorem principal_isCompactElt {X : Set γ} (hX : V.mem X) : IsCompactElt (V.principal hX) :=
  fun d hdir h => principal_compact hX d hdir h

end Algebraic
end DomainTheory.NeighbourhoodSystems
