  apply Set.iUnion_subset
  intro δ'
  exact (xStep.snd_subset hD₁nomin
    (atomPair.invariant D₀ D₁ hD₀pos hD₀diff hD₀nomin hD₁pos hD₁diff hD₁nomin X Y hXmem hYmem
