/-ai
The least solution of the equation that adjoins the unit, two named elements, and the pointwise square is the submonoid generated by those two elements.

The generated submonoid contains the unit and both generators and is closed under multiplication, so the operator sends it into itself, and the least fixed-point set is contained in every such pre-fixed point. Conversely, the fixed-point equation makes the least fixed-point set a pre-fixed point, and it contains both generators, so the submonoid it determines contains the generated submonoid.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise414
public import Mathlib.Algebra.Group.Submonoid.Basic
import all Mathlib.Algebra.Group.Submonoid.Basic
public import Mathlib.Algebra.Group.Pointwise.Set.Basic
import all Mathlib.Algebra.Group.Pointwise.Set.Basic
public import Mathlib.Algebra.Group.Nat.Defs
import all Mathlib.Algebra.Group.Nat.Defs
public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise417.Basic
public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise417.a_mem_F
public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise417.b_mem_F
public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise417.leastSolution_eq

public import DomainTheory.NeighbourhoodSystems.FixedPointsAndRecursion.Exercise414.lfpSet_subset
@[expose] public section


namespace DomainTheory.NeighbourhoodSystems.Exercise417

open Pointwise
open DomainTheory.NeighbourhoodSystems.Exercise414

variable {S : Type*} [Monoid S]


/-- **Exercise 4.17 (Scott 1981, PRG-19).** The least solution of `x = {1} ∪ {a, b} ∪ x · x` is the
submonoid generated by `{a, b}` (all finite products of `a`s and `b`s, including `1`). -/
theorem lfpSet_eq_closure (a b : S) :
    lfpSet (F a b) = (Submonoid.closure ({a, b} : Set S) : Set S) := by
  apply Set.Subset.antisymm
  · -- `lfpSet ⊆ closure`: the closure is a (pre-)fixed point of `F`.
    have hclosed : F a b (Submonoid.closure ({a, b} : Set S)) ⊆
        (Submonoid.closure ({a, b} : Set S) : Set S) := by
      apply Set.union_subset
      · apply Set.union_subset
        · rintro s rfl; exact (Submonoid.closure ({a, b} : Set S)).one_mem
        · intro s hs
          rcases hs with rfl | rfl
          · exact Submonoid.subset_closure (Set.mem_insert _ _)
          · exact Submonoid.subset_closure (Set.mem_insert_of_mem _ rfl)
      · rintro s ⟨t, ht, u, hu, rfl⟩
        exact (Submonoid.closure ({a, b} : Set S)).mul_mem ht hu
    exact lfpSet_subset (F a b) hclosed
  · -- `closure ⊆ lfpSet`: `lfpSet` is a submonoid containing `{a, b}`.
    have hfix : F a b (lfpSet (F a b)) ⊆ lfpSet (F a b) :=
      le_of_eq (leastSolution_eq a b)
    have ha : a ∈ lfpSet (F a b) := hfix (a_mem_F a b _)
    have hb : b ∈ lfpSet (F a b) := hfix (b_mem_F a b _)
    have hmem : ({a, b} : Set S) ⊆ lfpSet (F a b) := by
      intro s hs
      rcases Set.mem_insert_iff.mp hs with h | h
      · rw [h]; exact ha
      · rw [Set.mem_singleton_iff.mp h]; exact hb
    exact (Submonoid.closure_le (S := preFixSubmonoid a b hfix)).mpr hmem

end DomainTheory.NeighbourhoodSystems.Exercise417
