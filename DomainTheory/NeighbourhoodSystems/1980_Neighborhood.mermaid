%% Each box is one outline note from 1980_Neighborhood.md.
%% Lean modules = transitive closure of that note's @import Lean files.
%% Arrowhead on the importer. An arrow implied by a longer path is omitted.
flowchart TB

  DOM["Domains given<br>by neighbourhoods"]
  MAP["Mappings<br>between domains"]
  CON["Domain<br>constructs"]
  FIX["Fixed points<br>and recursion"]
  Typed___lambda__calculus["Typed \lambda-calculus"]
  EQ["Domain<br>equations"]
  Computability_in_effecti["Computability in effectively given domains"]
  Retracts_of_the_universa["Retracts of the universal domain"]

  MAP --> CON
  EQ --> Computability_in_effecti
  Typed___lambda__calculus --> EQ
  CON --> FIX
  DOM --> MAP
  Computability_in_effecti --> Retracts_of_the_universa
  FIX --> Typed___lambda__calculus

