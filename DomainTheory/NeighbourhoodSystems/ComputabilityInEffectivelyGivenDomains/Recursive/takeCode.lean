/-- Coded list take: `decodeList (takeCode n c) = (decodeList c).take n`. -/
def takeCode (n c : ℕ) : ℕ :=
  let len := listLenChar c
  let B := Nat.min n len
  tabCode takeListTabFn (Nat.pair B (Nat.pair n c)) B

end Domain.Recursive
