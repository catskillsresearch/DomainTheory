/-- `n.unpair.2 ≤ n` (choice-free); the decreasing measure for `decodeList`. -/
theorem unpair_snd_le (n : ℕ) : n.unpair.2 ≤ n := by
  have h := le_pair_right n.unpair.1 n.unpair.2
  rwa [pair_unpair] at h

end Domain.Recursive
