namespace Domain.Recursive

/-- The `{0,1}`-flag computed by threading witness code `w` through the list coded by `c`. -/
def reForallChar (qc : ℕ → ℕ) (w c : ℕ) : ℕ :=
  (foldCode (reForallStp qc) 0 (Nat.pair w 1) c).unpair.2

