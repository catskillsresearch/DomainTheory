/-- `notCode c` names `notFn (Tenum c)` when `c ≤ 2`: `0 ↦ 0`, `1 ↦ 2`, `2 ↦ 1`. -/
def notCode (c : ℕ) : ℕ := if c = 1 then 2 else if c = 2 then 1 else 0

