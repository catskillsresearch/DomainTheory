open NeighborhoodSystem Domain.Recursive

theorem finPrefix_succ (f : ℕ → ℕ) (n : ℕ) :
    finPrefix f (n + 1) = finPrefix f n ++ [f n] := by
  unfold finPrefix; rw [List.range_succ, List.map_append, List.map_singleton]

