open NeighborhoodSystem Domain.Recursive

theorem finPrefix_take (f : ℕ → ℕ) {n m : ℕ} (h : n ≤ m) :
    (finPrefix f m).take n = finPrefix f n := by
  unfold finPrefix; rw [← List.map_take, List.take_range, min_eq_left h]

