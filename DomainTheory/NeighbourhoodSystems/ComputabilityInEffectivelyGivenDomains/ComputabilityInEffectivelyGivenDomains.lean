/-- `n.unpair.1 ≤ n` (choice-free); the decreasing measure for `Vsharp`'s left child. -/
theorem unpair_fst_le (n : ℕ) : n.unpair.1 ≤ n := by
  have h := le_pair_left n.unpair.1 n.unpair.2
  rwa [pair_unpair] at h

end Proposition77
