theorem example_722_cat : ∀ {σ₁ σ₂ : Type} (M₁ : NFA Bool σ₁) (M₂ : NFA Bool σ₂),
  @Eq (Language Bool)
    (@εNFA.accepts Bool (Sum σ₁ σ₂) (@DomainTheory.NeighbourhoodSystems.Exercise722.catEps σ₁ σ₂ M₁ M₂))
