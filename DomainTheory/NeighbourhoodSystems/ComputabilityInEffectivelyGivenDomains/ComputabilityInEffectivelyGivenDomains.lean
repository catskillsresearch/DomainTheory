/-- **Proposition 7.12 — the binary join map on `D × D`.** -/
def finJoinMap_prod : ApproximableMap (prod V V) V.PowerDomain := ofMap₂ (PDfinJoinApproxMap₂ (V := V))

end NeighborhoodSystem
