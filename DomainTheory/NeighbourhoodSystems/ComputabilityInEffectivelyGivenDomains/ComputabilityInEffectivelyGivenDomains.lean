/-- The finite union of down-sets indexed by a `List` of `𝒟`-indices: `⋃_{b ∈ l} ↓X_b`. -/
def UPX (l : List ℕ) : Set (Set α) := ⋃ b ∈ l, V.upSet (P.X b)

end NeighborhoodSystem
