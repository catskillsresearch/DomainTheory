variable (P₀ : ComputablePresentation V₀) (P₁ : ComputablePresentation V₁)

/-- The step pair coded by an entry `e`: `(X_{e.unpair.1}, Y_{e.unpair.2})`. -/
def funPair (e : ℕ) : Set α × Set β := (P₀.X e.unpair.1, P₁.X e.unpair.2)
end

