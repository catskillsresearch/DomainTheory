/-- `listGet c i = (decodeList c).getD i 0`: the `i`-th entry of the list coded by `c`. -/
def listGet (c i : ℕ) : ℕ :=
  (foldCode listGetStp 0 (Nat.pair (i + 1) 0) c).unpair.2

end Proposition77
