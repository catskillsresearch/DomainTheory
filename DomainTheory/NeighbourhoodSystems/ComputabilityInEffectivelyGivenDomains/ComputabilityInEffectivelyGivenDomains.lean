include h₀ h₁ in
theorem sumEnum_nonempty (t : ℕ) : (sumEnum P₀ P₁ t).Nonempty := by
  unfold sumEnum
  split
  · exact inj₀_nonempty (h₀ _ (P₀.mem_X _))
  · split
    · exact inj₁_nonempty (h₁ _ (P₁.mem_X _))
    · exact ⟨none, none_mem_sumMaster⟩

