variable {σ₁ σ₂ : Type}

/-- A crude upper bound on `Fintype.card (autState e)` (used to bound word search length). -/
def autStateCard : SExpr → ℕ
  | .sigma => 1
  | .single σ => σ.length + 2
  | .cap a b => autStateCard a * autStateCard b
  | .cat a b => autStateCard a + autStateCard b
end

