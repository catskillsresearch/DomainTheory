/-ai
The singleton of the principal element of a neighbourhood X equals the principal element of the power domain generated by the down-set of X.

By extensionality, singleton membership gives a neighbourhood Y of the principal element, a power-domain neighbourhood, and an inclusion of the down-set of Y. The down-set criterion turns the principal inclusion of X in Y into an inclusion of the down-set of X in the down-set of Y, which composes to an inclusion in the given power-domain neighbourhood. Conversely, X itself, with the reflexive inclusion, is the singleton witness for that same power-domain neighbourhood.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Definition711
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Definition72
public import DomainTheory.NeighbourhoodSystems.MappingsBetweenDomains.ApproximableExercises
public import DomainTheory.NeighbourhoodSystems.DomainConstructs.Product
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Proposition710
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Theorem74
public import DomainTheory.NeighbourhoodSystems.DomainEquations.Lemma615
public import Mathlib.Tactic
import all Mathlib.Tactic
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Proposition712.Basic
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Proposition712.PDext

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems

open NeighborhoodSystem ApproximableMap ApproximableMap₂ Domain.Recursive

namespace NeighborhoodSystem

variable {α : Type*} (V : NeighborhoodSystem α)


/-- **Proposition 7.12 — on finite elements `{↑X} = ↑(↓X)`.** The singleton join of the principal
filter `↑X ⊆ |𝒟|` is the principal filter in `|ℙ𝒟|` generated by the down-set token `↓X`. -/
theorem PDsingleton_principal {X : Set α} (hX : V.mem X) :
    V.PDsingleton (V.principal hX) =
      V.PowerDomain.principal (V.PDmem_upSet hX) := by
  apply PDext
  intro W
  rw [PDmem_singleton, mem_principal, PowerDomain_mem]
  constructor
  · rintro ⟨Y, ⟨hYmem, hXY⟩, hPD, hsub⟩
    exact ⟨hPD, ((V.upSet_subset_iff hX).mpr hXY).trans hsub⟩
  · rintro ⟨hPD, hsub⟩
    exact ⟨X, ⟨hX, subset_rfl⟩, hPD, hsub⟩

end NeighborhoodSystem
end DomainTheory.NeighbourhoodSystems
