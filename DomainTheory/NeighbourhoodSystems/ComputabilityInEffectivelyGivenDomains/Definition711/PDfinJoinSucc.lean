/-ai
The successor join of a nonempty finite family is the power-domain element whose members are the sets satisfying the finite-join membership predicate. Such a set is a power-domain neighbourhood by that predicate. The master belongs by choosing the master neighbourhood in every coordinate: each element contains the master, the power-domain master is a power-domain neighbourhood, and each down-set of the master is contained in it. The intersection of two members is witnessed by intersecting the chosen representatives coordinatewise, using closure of each element and of the power domain under intersection, and rewriting the down-set of an intersection as the intersection of the down-sets. A larger power-domain neighbourhood containing a member still belongs, with the same representatives, because each down-set inclusion extends along the larger set.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Proposition710
public import Mathlib.Tactic
import all Mathlib.Tactic
public import DomainTheory.NeighbourhoodSystems.ComputabilityInEffectivelyGivenDomains.Definition711.PDmemFinJoin

@[expose] public section

set_option linter.unusedSectionVars false

namespace DomainTheory.NeighbourhoodSystems

namespace NeighborhoodSystem

variable {α : Type*} (V : NeighborhoodSystem α)

/-- **Definition 7.11 — the non-empty join.** For `n ≥ 1`, `{x₀,…,x_{n-1}}` is the filter
generated by Scott's union condition. -/
def PDfinJoinSucc {m : ℕ} (xs : Fin (m + 1) → V.Element) : V.PowerDomain.Element where
  mem := V.PDmemFinJoin xs
  sub hW := by obtain ⟨_, _, hPD, _⟩ := hW; exact hPD
  master_mem := by
    refine ⟨fun i => V.master, fun i => (xs i).master_mem, V.PDmem_master, fun i Z hz => hz⟩
  inter_mem h1 h2 := by
    obtain ⟨X1, hX1, hPD1, hsub1⟩ := h1
    obtain ⟨X2, hX2, hPD2, hsub2⟩ := h2
    refine ⟨fun i => X1 i ∩ X2 i, fun i => (xs i).inter_mem (hX1 i) (hX2 i),
      V.PDmem_inter hPD1 hPD2, fun i Y hY => ?_⟩
    rw [← V.upSet_inter] at hY
    rcases hY with ⟨hY1, hY2⟩
    exact ⟨hsub1 i hY1, hsub2 i hY2⟩
  up_mem h hW hsub := by
    obtain ⟨X, hX, _, hsub'⟩ := h
    exact ⟨X, hX, hW, fun i => (hsub' i).trans hsub⟩

end NeighborhoodSystem

end DomainTheory.NeighbourhoodSystems
