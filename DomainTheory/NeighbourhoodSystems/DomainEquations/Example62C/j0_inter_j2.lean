open NeighborhoodSystem ApproximableMap ExampleB Example44 Example62

variable {α β γ : Type*}

theorem j0_inter_j2 (X : Set α) (Z : Set γ) :
    (j0 X ∩ j2 Z : Set (Option (α ⊕ β ⊕ γ))) = ∅ := by
  ext w; rcases w with _ | (a | b | c) <;>
    simp [j0, j2, t0, t2, Set.mem_inter_iff]

