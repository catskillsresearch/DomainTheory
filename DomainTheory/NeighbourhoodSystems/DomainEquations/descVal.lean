variable (B : TAlgebra Tc)

/-- The recursion `φ(Λ)=z`, `φ(b·σ)=f_b(φ(σ))` on a finite string, with base value `z`. -/
def descVal (z : B.carrier.sys.Element) : Str → B.carrier.sys.Element
