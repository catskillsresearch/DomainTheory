/-- The argument element of `𝒩` carrying a `List.Vector ℕ n` in its first `n` coordinates. -/
def vecElem {n : ℕ} (v : List.Vector ℕ n) : 𝒩.Element :=
  argElem (fun i => some (v.get i))

