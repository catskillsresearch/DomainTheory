variable {α β : Type*}

@[simp] theorem il_mem_inj₁ {Y : Set β} {a : α} : (il a : Option (α ⊕ β)) ∉ inj₁ Y := by
  rintro ⟨b, _, hb⟩; exact absurd hb (by simp [il, ir])

