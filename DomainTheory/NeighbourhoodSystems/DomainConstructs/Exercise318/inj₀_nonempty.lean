open NeighborhoodSystem ApproximableMap

variable {α β : Type*}

theorem inj₀_nonempty {X : Set α} (hX : X.Nonempty) : (inj₀ X : Set (Option (α ⊕ β))).Nonempty :=
  Set.Nonempty.image il hX

