/-ai
The composite of the decoding after the encoding equals the identity on the binary system.

Compare relations by extensionality of approximable maps. In the forward direction, the composite places the encoding of one string inside an iterate neighbourhood contained in the encoding of another, so the first encoding is contained in the second, and prefix recovery supplies the cone inclusion of the identity. Conversely, the identity gives cones of two strings with the second a prefix of the first; the encoding of the longer string witnesses the composite, using that encoding reverses the prefix.
ai-/
module

public import DomainTheory.NeighbourhoodSystems.MappingsBetweenDomains.Example23
public import DomainTheory.NeighbourhoodSystems.DomainConstructs.Exercise316
public import DomainTheory.NeighbourhoodSystems.DomainConstructs.FunctionSpace
public import DomainTheory.NeighbourhoodSystems.DomainConstructs.Exercise317.Basic
public import DomainTheory.NeighbourhoodSystems.DomainConstructs.Exercise317.prefix_of_encSet_subset

@[expose] public section


namespace DomainTheory.NeighbourhoodSystems.Exercise317

open DomainTheory.NeighbourhoodSystems NeighborhoodSystem ExampleB ApproximableMap




















/-- **Exercise 3.17 — `g` is a retraction of `f`.** `g ∘ f = I_B`. -/
theorem gf_eq_id : g.comp f = idMap B := by
  apply ApproximableMap.ext
  intro X Y
  rw [comp_rel, idMap_rel]
  constructor
  · rintro ⟨W, ⟨σ, hX, _, hσW⟩, _, τ, hY, hWτ⟩
    refine ⟨hX ▸ memB_cone σ, hY ▸ memB_cone τ, ?_⟩
    have hsub : encSet σ ⊆ encSet τ := hσW.trans hWτ
    rw [hX, hY]
    exact cone_subset_cone.mpr (prefix_of_encSet_subset hsub)
  · rintro ⟨hX, hY, hXY⟩
    obtain ⟨σ, rfl⟩ := hX
    obtain ⟨τ, rfl⟩ := hY
    have hpre : τ <+: σ := cone_subset_cone.mp hXY
    exact ⟨encSet σ, ⟨σ, rfl, encSet_mem σ, subset_rfl⟩,
      encSet_mem σ, τ, rfl, encSet_anti hpre⟩

end DomainTheory.NeighbourhoodSystems.Exercise317
