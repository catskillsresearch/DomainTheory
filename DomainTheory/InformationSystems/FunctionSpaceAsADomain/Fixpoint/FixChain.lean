/-ai
A fix chain of length n for a finite set w of function tokens, in the sense of the least-fixed-point construction, is defined by recursion on n. The chain of length zero is the empty set. A set v is a chain of length n + 1 when some consistent set u is a chain of length n and w entails the function token with input u and output v.
ai-/

module

public import DomainTheory.InformationSystems.FunctionSpaceAsADomain.Theorem72
public import DomainTheory.InformationSystems.ElementsOfASystem.Factoid33

@[expose] public section

namespace DomainTheory.InformationSystems

open DomainTheory.InformationSystems.Constructive

namespace InfoSys

variable {α : Type*} [DecidableEq α] (A : InfoSys α)

/-- A length-`n` chain under the approximable map generated by `w`. -/
def FixChain (w : Finset (FunToken A A)) : Nat → Finset α → Prop
  | 0, v => v = ∅
  | n + 1, v =>
      ∃ u : Finset α, FixChain w n u ∧
        ∃ (hu : u ∈ A.Con) (hv : v ∈ A.Con),
          FunEnt A A w (mkFunToken A A u v hu hv)

end InfoSys

end DomainTheory.InformationSystems
