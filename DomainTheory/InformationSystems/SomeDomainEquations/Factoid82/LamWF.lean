variable {α : Type*} [DecidableEq α]

variable (A : InfoSys α)

class LamWF (t : RawLamToken α) : Prop where
  out : match t with
    | .bot | .atom _ => True
    | .funTok xs ys => LamConDepth A (listToFinset xs) ∧ LamConDepth A (listToFinset ys)

