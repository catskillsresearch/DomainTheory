theorem vPairRFinset_insert_bot (u : Finset VToken) :
    vPairRFinset (insert (.bot : VToken) u) = vPairRFinset u := by
  ext t; simp only [mem_vPairRFinset, Finset.mem_insert]
  constructor
  · rintro (h | h); exacts [False.elim (nomatch h), h]
  · exact Or.inr

