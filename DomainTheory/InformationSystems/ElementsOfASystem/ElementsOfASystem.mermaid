%% Inside ElementsOfASystem. A box is one Lean file in this folder, or one subfolder.
%% A box named as another folder is that whole folder. A box named as another chapter is that whole chapter.
%% The arrowhead points at the file or folder that imports. The label is how many direct imports.
flowchart TB
  N0["InformationSystems"]
  N1["Factoid32/"]
  N2["Factoid32"]
  N3["Factoid33/"]
  N4["Factoid33"]
  N5["Factoid34/"]
  N6["Factoid34"]
  N7["Factoid35/"]
  N8["Factoid35"]
  N9["Factoid36/"]
  N10["Factoid36"]

  N0 -->|"2"| N1
  N1 -->|"1"| N2
  N2 -->|"3"| N3
  N3 -->|"1"| N4
  N0 -->|"12"| N5
  N5 -->|"1"| N6
  N0 -->|"5"| N7
  N7 -->|"1"| N8
  N0 -->|"8"| N9
  N8 -->|"8"| N9
  N9 -->|"2"| N10

  classDef file fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef ext fill:#f3f4f6,stroke:#374151,color:#111827

  class N0 ext
  class N1 file
