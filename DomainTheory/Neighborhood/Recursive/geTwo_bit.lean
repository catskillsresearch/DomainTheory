/-- The `{0,1}` indicator of `2 ≤ a`, written via truncated subtraction. -/
theorem geTwo_bit (a : ℕ) : 1 - (2 - a) = if 2 ≤ a then 1 else 0 := by split <;> omega

end Domain.Recursive
