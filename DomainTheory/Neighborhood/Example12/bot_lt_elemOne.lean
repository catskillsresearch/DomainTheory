import DomainTheory.Neighborhood.Basic
import Mathlib.Tactic
import DomainTheory.Neighborhood.Example12.Basic


namespace DomainTheory.Neighborhood.Example12























namespace neighborhoodSystem

open NeighborhoodSystem






theorem bot_lt_elemOne : bot < elemOne := by
  constructor
  · intro X hx; exact Or.inl hx
  · intro h
    have : bot.mem one := h one (Or.inr rfl)
    have hm : one = master := this
    exact one_ne_master hm

end neighborhoodSystem
end DomainTheory.Neighborhood.Example12
