import DomainTheory.Neighborhood.Example23
import DomainTheory.Neighborhood.Exercise316
import DomainTheory.Neighborhood.FunctionSpace
import DomainTheory.Neighborhood.Exercise317.Basic
import DomainTheory.Neighborhood.Exercise317.prefix_of_encSet_subset


namespace DomainTheory.Neighborhood.Exercise317

open DomainTheory.Neighborhood NeighborhoodSystem ExampleB ApproximableMap




















/-- **Exercise 3.17 — `g` is a retraction of `f`.** `g ∘ f = I_B`. -/
theorem gf_eq_id : g.comp f = idMap B := by
  apply ApproximableMap.ext
  intro X Y
  rw [comp_rel, idMap_rel]
  constructor
  · rintro ⟨W, ⟨σ, hX, _, hσW⟩, _, τ, hY, hWτ⟩
    refine ⟨hX ▸ memB_cone σ, hY ▸ memB_cone τ, ?_⟩
    have hsub : encSet σ ⊆ encSet τ := hσW.trans hWτ
    rw [hX, hY]
    exact cone_subset_cone.mpr (prefix_of_encSet_subset hsub)
  · rintro ⟨hX, hY, hXY⟩
    obtain ⟨σ, rfl⟩ := hX
    obtain ⟨τ, rfl⟩ := hY
    have hpre : τ <+: σ := cone_subset_cone.mp hXY
    exact ⟨encSet σ, ⟨σ, rfl, encSet_mem σ, subset_rfl⟩,
      encSet_mem σ, τ, rfl, encSet_anti hpre⟩

end DomainTheory.Neighborhood.Exercise317
