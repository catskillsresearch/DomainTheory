  PINF -->|"1"| EINF
  TPROJ -->|"1"| EINF
  JINF -->|"1"| ESUP
  INCL -->|"1"| IINF
  JINF -->|"1"| INCL
  JINF -->|"1"| ISUP
  IINF -->|"1"| JINF
  CONJX -->|"2"| PINF
  EINF -->|"1"| PINF
  ESUP -->|"1"| PINF
  JINF -->|"1"| TPROJ

  classDef concept fill:#dcfce7,stroke:#15803d,color:#14532d
