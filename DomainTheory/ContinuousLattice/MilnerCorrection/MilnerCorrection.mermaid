%% Inside MilnerCorrection. A box is one Lean file in this folder, or one subfolder.
%% A box named as another folder is that whole folder. A box named as another chapter is that whole chapter.
%% The arrowhead points at the file or folder that imports. The label is how many direct imports.
flowchart TB
  N0["Specialization"]
  N1["WayBelow"]
  N2["CoarserThanScottTopology"]
  N3["scottLowerSubbasisSet"]
  N4["scottOpen_of_coarserThanScott"]
  N5["scottPrincipalUpSet"]

  N0 -->|"1"| N2
  N0 -->|"1"| N4
  N1 -->|"1"| N4
  N2 -->|"1"| N4

  classDef file fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef ext fill:#f3f4f6,stroke:#374151,color:#111827

  class N0 ext
  class N1 ext
  class N2 file
  class N3 file
  class N4 file
  class N5 file
