%% Inside NeighborhoodToInfoSys. A box is one Lean file in this folder, or one subfolder.
%% A box named as another folder is that whole folder. A box named as another chapter is that whole chapter.
%% The arrowhead points at the file or folder that imports. The label is how many direct imports.
flowchart TB

  N3["domainOrderIso"]
  N1["InformationSystems"]
  interOf_empty_lean["interOf_empty.lean"]
  NbhdBasis_lean["NbhdBasis.lean"]
  N2["NeighbourhoodSystems"]
  ofElement_lean["ofElement.lean"]
  ofElement_toElement_lean["ofElement_toElement.lean"]
  toElement_lean["toElement.lean"]
  toElement_ofElement_lean["toElement_ofElement.lean"]
  toInfoSys_lean["toInfoSys.lean"]

  N1 -->|"3"| N3
  N2 -->|"1"| N3
  NbhdBasis_lean -->|"1"| N3
  interOf_empty_lean -->|"1"| N3
  ofElement_lean -->|"1"| N3
  ofElement_toElement_lean -->|"1"| N3
  toElement_lean -->|"1"| N3
  toElement_ofElement_lean -->|"1"| N3
  toInfoSys_lean -->|"1"| N3

  classDef file fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
