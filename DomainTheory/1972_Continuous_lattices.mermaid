%% Notes of section 2, continuous lattices, in the paper's order.
%% Theorem 2.12 is filed in section 3, after the corrected Proposition 2.10.
%% Arrowhead on the importer. The number is a direct-import count.
%% An arrow already implied by a longer path is omitted.
%% The flawed proof of Proposition 2.10 has no Lean files.
flowchart TB

  D23["Definition 2.3\nContinuous Lattice"]
  MC["Milner Correction"]
  P21["Proposition 2.1"]
  SM["Scott Maps"]
  SO["Scott open"]
  SP["Specialization"]
  WB["Way-below relation"]

  WB -->|"1"| D23
  SP -->|"2"| MC
  SM -->|"2"| P21
  P21 -->|"1"| SP
  SO -->|"1"| WB

  classDef concept fill:#dcfce7,stroke:#15803d,color:#14532d
  classDef numbered fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef definition fill:#fae8ff,stroke:#a21caf,color:#701a75
  class SP,SO,WB,SM,MC concept
  class P21,P211 numbered
