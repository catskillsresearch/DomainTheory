%% Each box is one outline note from 1976_Continuous_functions.md.
%% Lean modules = transitive closure of that note's @import Lean files.
%% Arrowhead on the importer. An arrow implied by a longer path is omitted.
flowchart TB

  E["e"]
  PAIR["pair"]
  CONT["Continuous"]
  GRA["Graph"]
  FIX["FixedPoint"]
  EMB["Embedding"]

  PAIR --> CONT
  CONT --> EMB
  CONT --> FIX
  CONT --> GRA
  E --> PAIR

  classDef c1 fill:#dcfce7,stroke:#15803d,color:#14532d
  classDef c6 fill:#ccfbf1,stroke:#0f766e,color:#134e4a
  classDef c2 fill:#fef3c7,stroke:#b45309,color:#78350f
  classDef c3 fill:#fce7f3,stroke:#be185d,color:#831843
  classDef c4 fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d
  classDef c5 fill:#e0e7ff,stroke:#4338ca,color:#312e81
