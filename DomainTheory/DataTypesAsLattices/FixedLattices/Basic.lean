module

public import Mathlib.Order.CompleteLattice.Defs
import all Mathlib.Order.CompleteLattice.Defs
public import Mathlib.Data.Finset.Basic
import all Mathlib.Data.Finset.Basic
public import DomainTheory.DataTypesAsLattices.FixedLattices.CountablyAlgebraic

@[expose] public section

/-!
# Directed compactness and countable algebraic lattices

The interfaces in this file are deliberately order-theoretic.  In particular,
compactness is measured in the lattice under consideration, not in an ambient
powerset.
-/

namespace DomainTheory.DataTypesAsLattices


/-- A basis witnesses the continuous-lattice property by way-below elements. -/
def IsContinuousBasis {α : Type u} [CompleteLattice α]
    (basis : α → Set α) : Prop :=
  ∀ x, @IsDirectedSet α completeLatticePreorder (basis x) ∧
    (∀ y ∈ basis x, WayBelow y x) ∧
    x = @sSup α completeLatticeSupSet (basis x)


/-- Suprema generated by finite parts of a set of basis indices. -/
def finiteBasisSups {α : Type u} [CompleteLattice α]
    (d : ℕ → α) (x : Set ℕ) : Set α :=
  {y | ∃ t : Finset ℕ, (t : Set ℕ) ⊆ x ∧
    y = sSup (d '' (t : Set ℕ))}
end DomainTheory.DataTypesAsLattices
