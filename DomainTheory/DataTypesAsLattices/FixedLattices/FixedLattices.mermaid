%% Inside FixedLattices. A box is one Lean file in this folder, or one subfolder.
%% A box named as another folder is that whole folder. A box named as another chapter is that whole chapter.
%% The arrowhead points at the file or folder that imports. The label is how many direct imports.
flowchart TB

  N7["ContinuousBasis"]
  N6["CountablyAlgebraic"]
  CountablyAlgebraic_more["CountablyAlgebraic_more"]
  N8["finiteBasisSups"]
  N5["IsCompact"]
  N4["WayBelow"]

  N6 -->|"1"| CountablyAlgebraic_more
  N8 -->|"1"| CountablyAlgebraic_more
  N4 -->|"1"| N5
  N5 -->|"1"| N6
  N4 -->|"1"| N7
  N6 -->|"1"| N8

  classDef file fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef ext fill:#f3f4f6,stroke:#374151,color:#111827
  class CountablyAlgebraic_more file
  class N4 file
  class N5 file
  class N6 file
  class N7 file
  class N8 file
