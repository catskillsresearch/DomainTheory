%% Computability and definability.
%% Each box is a note. Arrowhead on the importer.
%% The number is a direct-import count.
%% An arrow already implied by a longer path is omitted.
%% Imports of a folder barrel are not counted.
flowchart TB

  LY["A law of Y"]
  REC["Computable functions"]
  DEF["Definability"]
  DOL["Distributive functions"]
  EL["Elementary definitions"]
  LAM["LAMBDA"]
  MEAN["Meaning"]
  PR["Primitive recursion"]
  SEQ["Sequences"]
  YC["The combinator Y"]
  GRA["The graph model"]
  T21["Theorem 2.1"]
  T22["Theorem 2.2"]
  T23["Theorem 2.3"]
  T24["Theorem 2.4"]
  T25["Theorem 2.5"]
  T26["Theorem 2.6"]

  LAM -->|"11"| DEF
