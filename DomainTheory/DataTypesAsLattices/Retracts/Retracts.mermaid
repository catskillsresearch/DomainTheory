%% Each box is one outline note from 1976_Retracts_and_data_types.md.
%% Lean modules = transitive closure of that note's @import Lean files.
%% Arrowhead on the importer. An arrow implied by a longer path is omitted.
%% Reading order for definition notes; Lean edges for theorem deps.
flowchart TB

  INTRO["Introduction"]
  GLEM["Graph lemmas"]
  PRED["Predecessor set"]
  FIXP["Fixpoints"]
  DFIX["Directed fixpoints"]
  DRET["Definition (retract)"]
  T41["Theorem 4.1"]
  DMEM["u is in the range of retract a"]
  DORD["Definition (ordering)"]
  OPENR["Open retract"]
  T42["Theorem 4.2"]
  T43["Theorem 4.3"]
  T44["Theorem 4.4"]
  T45["Theorem 4.5"]
  T46["Theorem 4.6"]

  FIXP --> DFIX
  T41 --> DMEM
  DMEM --> DORD
  DFIX --> DRET
  PRED --> FIXP
  INTRO --> GLEM
  DORD --> OPENR
  GLEM --> PRED
  DRET --> T41
  OPENR --> T42
  T42 --> T43
  T43 --> T44
  T44 --> T45
  T45 --> T46

  classDef file fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef ext fill:#f3f4f6,stroke:#374151,color:#111827
