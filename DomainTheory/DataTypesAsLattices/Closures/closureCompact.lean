/-ai
The fixed point generated by the finite set e n is the application of the closure a to e n, packaged as a fixed point of application of a. Double application of a is Scott continuous, the beta law identifies the composite with double application, and evaluating the retract equation of a at e n shows that this value is fixed.
ai-/
module

public import Mathlib.Algebra.Ring.Parity
public import DomainTheory.DataTypesAsLattices.Retracts
public import DomainTheory.DataTypesAsLattices.Closures.Closure

@[expose] public section

namespace DomainTheory.DataTypesAsLattices

/-- The fixed point generated by the finite set `e n`. -/
def closureCompact (a : Pomega) (ha : Closure a) (n : ℕ) :
    Fixpoints (funOf a) :=
  ⟨funOf a (e n), by
    have hcont : IsScottContinuous (fun y => funOf a (funOf a y)) :=
      theorem_1_3 (funOf_isScottContinuous a) (funOf_isScottContinuous a)
    have hbeta := (theorem_1_2 hcont (comp a a)).1
    have h := congrArg (fun u => funOf u (e n)) ha.out.2.out
    have hcomp : funOf (comp a a) (e n) = funOf a (funOf a (e n)) :=
      congrArg (fun f => f (e n)) hbeta
    exact hcomp.symm.trans h.symm⟩

end DomainTheory.DataTypesAsLattices
