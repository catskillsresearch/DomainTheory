/-ai
Disjoint pairing is Scott continuous in the second argument, for a fixed first argument.

An even member, coming from the fixed first set, lies in the Scott union at the empty finite set. An odd member, coming from the varying second set, lies in the Scott union at the finite set whose only member is that element. Conversely, an even Scott-union witness is unchanged, and an odd witness pulls its second component back along the finite inclusion.
ai-/
module

public import Mathlib.Algebra.Ring.Parity
import all Mathlib.Algebra.Ring.Parity
public import DomainTheory.DataTypesAsLattices.Retracts
public import DomainTheory.DataTypesAsLattices.Closures.Basic

@[expose] public section


namespace DomainTheory.DataTypesAsLattices


theorem squarePair_isScottContinuous_right (x : Pomega) :
    IsScottContinuous (fun y => squarePair x y) := by
  intro y
  ext k
  constructor
  · intro hk
    rcases hk with ⟨n, hn, hk⟩ | ⟨m, hm, hk⟩
    · exact mem_scottUnion.mpr ⟨0, by simp [e_zero], Or.inl ⟨n, hn, hk⟩⟩
    · exact mem_scottUnion.mpr ⟨2 ^ m, by simp [e_pow2, Set.singleton_subset_iff, hm],
        Or.inr ⟨m, by simp [e_pow2], hk⟩⟩
  · intro hk
    obtain ⟨p, hp, hkp⟩ := mem_scottUnion.mp hk
    rcases hkp with ⟨n, hn, hk⟩ | ⟨m, hm, hk⟩
    · exact Or.inl ⟨n, hn, hk⟩
    · exact Or.inr ⟨m, hp hm, hk⟩

end DomainTheory.DataTypesAsLattices
