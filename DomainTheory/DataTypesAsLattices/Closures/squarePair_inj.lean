theorem squarePair_inj {x x' y y' : Pomega}
    (h : squarePair x y = squarePair x' y') : x = x' ∧ y = y' :=
  ⟨(eq_5_9 x y).symm.trans ((congrArg squareFst h).trans (eq_5_9 x' y')),
    (eq_5_10 x y).symm.trans ((congrArg squareSnd h).trans (eq_5_10 x' y'))⟩

