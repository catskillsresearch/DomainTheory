/-ai
This module introduces the positive information topology on Pω from Scott 1976, §1, namely the topology generated by the subbasic opens of those elements that contain a fixed natural number, and it re-exports the basic neighbourhoods, Scott opens, Scott pieces, and Scott continuity used for that topology.
ai-/
module

public import Mathlib.Topology.Bases
import all Mathlib.Topology.Bases
public import Mathlib.Topology.Order
import all Mathlib.Topology.Order
public import DomainTheory.DataTypesAsLattices.Pomega
public import DomainTheory.DataTypesAsLattices.Continuous.basicNhhd
public import DomainTheory.DataTypesAsLattices.Continuous.IsScottOpen
public import DomainTheory.DataTypesAsLattices.Continuous.scottPiece
public import DomainTheory.DataTypesAsLattices.Continuous.scottUnion
public import DomainTheory.DataTypesAsLattices.Continuous.IsScottContinuous
public import DomainTheory.DataTypesAsLattices.Continuous.memOpen

@[expose] public section

/-!
# Scott 1976, §1 — Scott topology and continuous maps on `Pω`

Definitions of basic neighbourhoods, open sets, and Scott continuity,
plus Theorem 1.1 (characterization).
-/

namespace DomainTheory.DataTypesAsLattices

open TopologicalSpace


/-- **Scott 1976, §1.** The positive (“information”) topology on `Pω`,
generated by the sets `{x | k ∈ x}`. -/
instance : TopologicalSpace Pomega :=
  .generateFrom (Set.range memOpen)
end DomainTheory.DataTypesAsLattices
