/-ai
If U is open in the topology generated by the subbasic opens and x lies in U, then some finite code n has its finite set contained in x and its basic neighbourhood contained in U.

The argument is an induction on the way U is generated. A subbasic open of elements containing k is the basic neighbourhood of the code 2^k, and membership of x supplies the inclusion of that finite set. The whole space is the basic neighbourhood of 0. For an intersection, the inductive codes are combined by bitwise or, and the intersection identity for basic neighbourhoods keeps the combined neighbourhood inside the intersection. For a union, the member that contains x contributes a code, and that basic neighbourhood sits inside the union.
ai-/
module

public import Mathlib.Topology.Bases
public import Mathlib.Topology.Order
public import DomainTheory.DataTypesAsLattices.Pomega
public import DomainTheory.DataTypesAsLattices.Continuous.Basic
public import DomainTheory.DataTypesAsLattices.Continuous.basicNhhd_inter
public import DomainTheory.DataTypesAsLattices.Continuous.basicNhhd_zero
public import DomainTheory.DataTypesAsLattices.Continuous.memOpen_eq_basicNhhd

@[expose] public section


namespace DomainTheory.DataTypesAsLattices

open TopologicalSpace


/-- Every open neighbourhood of `x` contains a basic neighbourhood of `x`. -/
theorem exists_basicNhhd_subset_of_generateOpen {U : Set Pomega}
    (hU : GenerateOpen (Set.range memOpen) U) {x : Pomega} (hx : x ∈ U) :
    ∃ n, e n ⊆ x ∧ basicNhhd n ⊆ U := by
  induction hU generalizing x with
  | basic s hs =>
    obtain ⟨k, rfl⟩ := hs
    refine ⟨2 ^ k, ?_, ?_⟩
    · simpa [memOpen, e_pow2, Set.singleton_subset_iff] using hx
    · rw [← memOpen_eq_basicNhhd]
  | univ =>
    exact ⟨0, by simp [e_zero], by simp [basicNhhd_zero]⟩
  | inter _s _t _hs _ht ihs iht =>
    obtain ⟨n, hn, hnU⟩ := ihs hx.1
    obtain ⟨m, hm, hmU⟩ := iht hx.2
    refine ⟨n ||| m, e_or_of_subset hn hm, ?_⟩
    rw [← basicNhhd_inter]
    exact Set.inter_subset_inter hnU hmU
  | sUnion S _hS ih =>
    obtain ⟨V, hV, hxV⟩ := hx
    obtain ⟨n, hn, hnV⟩ := ih V hV hxV
    exact ⟨n, hn, hnV.trans (Set.subset_sUnion_of_mem hV)⟩

end DomainTheory.DataTypesAsLattices
