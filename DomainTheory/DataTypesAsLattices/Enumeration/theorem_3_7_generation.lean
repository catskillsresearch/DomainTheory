/-ai
Every element of the intersection of the recursively enumerable elements and the functional elements is generated by R, L, and the bar combinator. This is the generation direction of Scott's Theorem 3.7.

From membership in the recursively enumerable elements, the forward direction of Theorem 3.1 supplies the hypothesis of bar generation, so the bar of the element is semigroup-generated. Left composition with L and right composition with R preserve semigroup generation. Rewriting by the operator form of equation 3.16 and substituting functionality shows that the element itself is semigroup-generated.
ai-/

module

public import Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic
public import DomainTheory.DataTypesAsLattices.Enumeration.bar_generated
public import DomainTheory.DataTypesAsLattices.Enumeration.eq_3_16_operator

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices


open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code


/-- The substantive generation direction of Scott 1976, Theorem 3.7:
every element of `RE ∩ FUN` is generated by `R`, `L`, and `Ḡ`. -/
theorem theorem_3_7_generation {u : Pomega}
    (huRE : u ∈ RE) (huFUN : u ∈ FUN) : GeneratedSemigroup u := by
  have hbar : GeneratedSemigroup (funOf barComb u) :=
    bar_generated ((theorem_3_1 (u := u)).mp huRE)
  have hgen : GeneratedSemigroup
      (enumComp Lcomb (enumComp (funOf barComb u) Rcomb)) :=
    .comp .L (.comp hbar .R)
  rw [eq_3_16_operator] at hgen
  simpa [FUN] using huFUN ▸ hgen

end DomainTheory.DataTypesAsLattices
