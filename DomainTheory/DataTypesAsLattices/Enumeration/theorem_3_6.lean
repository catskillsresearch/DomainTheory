/-ai
A set of elements of Pω is an enumeration degree if and only if it is the combinatory subalgebra generated by some finite list.

If the set is the degree of an element a, it equals the subalgebra generated by the singleton list of a. An element of the degree is a combinatory application to a, and the generated subalgebra contains every combinator and contains the generator a. Conversely, every element of the generated subalgebra lies in every subalgebra containing the generators, and the degree of a is such a subalgebra containing a. In the other direction, the subalgebra generated by a list equals the degree of the single generator of that list.
ai-/

module

public import Mathlib.Computability.Halting
import all Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic
public import DomainTheory.DataTypesAsLattices.Enumeration.Deg_isSubalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.Deg_self
public import DomainTheory.DataTypesAsLattices.Enumeration.GeneratedSubalgebra_isSubalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.GeneratedSubalgebra_generator
public import DomainTheory.DataTypesAsLattices.Enumeration.combinatory_mem_subalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.theorem_3_6_generated

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices




































































open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code






















































/-- Exact finite-generation classification of enumeration degrees. -/
theorem theorem_3_6 (A : Set Pomega) :
    (∃ a, A = Deg a) ↔
      ∃ xs : List Pomega, A = GeneratedSubalgebra xs := by
  constructor
  · rintro ⟨a, rfl⟩
    refine ⟨[a], ?_⟩
    ext u
    constructor
    · rintro ⟨r, hr, rfl⟩
      exact (GeneratedSubalgebra_isSubalgebra [a]).2
        (combinatory_mem_subalgebra (GeneratedSubalgebra_isSubalgebra [a]) hr)
        (GeneratedSubalgebra_generator (by simp))
    · intro hu
      exact hu _ (Deg_isSubalgebra a) (by
        intro x hx
        simp at hx
        subst x
        exact Deg_self a)
  · rintro ⟨xs, rfl⟩
    exact ⟨singleGenerator xs, theorem_3_6_generated xs⟩

end DomainTheory.DataTypesAsLattices
