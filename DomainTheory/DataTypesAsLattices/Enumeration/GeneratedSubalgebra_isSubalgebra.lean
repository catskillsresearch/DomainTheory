/-ai
The combinatory subalgebra generated by a finite list is itself a combinatory subalgebra.

It contains G because every combinatory subalgebra contains G. If two elements belong to it, then in any combinatory subalgebra that contains the generators both elements are present, and closure under application puts their application in that subalgebra.
ai-/
module

public import Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices


open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code


theorem GeneratedSubalgebra_isSubalgebra (xs : List Pomega) :
    Subalgebra (GeneratedSubalgebra xs) := by
  constructor
  constructor
  · intro A hA _
    exact hA.out.1
  · intro u v hu hv A hA hxs
    exact hA.out.2 (hu A hA hxs) (hv A hA hxs)

end DomainTheory.DataTypesAsLattices
