/-ai
Every entry of a finite list belongs to the combinatory subalgebra generated by that list.

Any combinatory subalgebra that contains every entry of the list contains the given entry.
ai-/
module

public import Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices


open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code


theorem GeneratedSubalgebra_generator {xs : List Pomega} {x : Pomega}
    (hx : x ∈ xs) : x ∈ GeneratedSubalgebra xs :=
  fun _ _ hxs => hxs x hx

end DomainTheory.DataTypesAsLattices
