/-ai
An element lies in the intersection of the recursively enumerable elements and the functional elements if and only if it belongs to the semigroup generated by R, L, and the bar combinator. This is Scott's semigroup theorem (Theorem 3.7): the countable semigroup of computable enumeration operators is finitely generated by those three elements.

One direction is the generation clause of Theorem 3.7. The other is that every semigroup-generated element lies in that intersection.
ai-/

module

public import Mathlib.Computability.Halting
import all Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic
public import DomainTheory.DataTypesAsLattices.Enumeration.theorem_3_7_generation
public import DomainTheory.DataTypesAsLattices.Enumeration.generatedSemigroup_mem_RE_FUN

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices




































































open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code





















































/-- **Scott 1976, Theorem 3.7 (The semigroup theorem).**
The countable semigroup `RE ∩ FUN` of computable enumeration operators
is finitely generated by `R`, `L` and `Ḡ`. -/
theorem theorem_3_7 {u : Pomega} :
    u ∈ RE ∩ FUN ↔ GeneratedSemigroup u :=
  ⟨fun h => theorem_3_7_generation h.1 h.2, generatedSemigroup_mem_RE_FUN⟩

end DomainTheory.DataTypesAsLattices
