/-ai
The least subalgebra generated by a finite list equals the degree of the single packed generator of that list. This is Scott's Theorem 3.6.

An element of the generated subalgebra lies in every subalgebra containing the generators, and the degree of the single generator is such a subalgebra because the generators lie in that degree. Conversely, an element of the degree is a combinatory application to the single generator. In any subalgebra containing the generators, the combinator lies in the subalgebra and the single generator lies in the subalgebra, so the application does as well.
ai-/

module

public import Mathlib.Computability.Halting
public import DomainTheory.DataTypesAsLattices.Computability
public import DomainTheory.DataTypesAsLattices.Functionality
public import DomainTheory.DataTypesAsLattices.Enumeration.Basic
public import DomainTheory.DataTypesAsLattices.Enumeration.Deg_isSubalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.combinatory_mem_subalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.singleGenerator_mem_subalgebra
public import DomainTheory.DataTypesAsLattices.Enumeration.generators_mem_singleGenerator_degree

@[expose] public section


set_option maxHeartbeats 2000000

namespace DomainTheory.DataTypesAsLattices


open Encodable
open Nat.Partrec (Code)
open Nat.Partrec.Code


/-- **Scott 1976, Theorem 3.6.** The least subalgebra generated by a finite
list is exactly the degree of Scott's single packed generator. -/
theorem theorem_3_6_generated (xs : List Pomega) :
    GeneratedSubalgebra xs = Deg (singleGenerator xs) := by
  ext u
  constructor
  · intro hu
    exact hu _ (Deg_isSubalgebra _) (generators_mem_singleGenerator_degree xs)
  · rintro ⟨r, hr, rfl⟩ A hA hxs
    exact hA.out.2 (combinatory_mem_subalgebra hA hr)
      (singleGenerator_mem_subalgebra hA hxs)

end DomainTheory.DataTypesAsLattices
