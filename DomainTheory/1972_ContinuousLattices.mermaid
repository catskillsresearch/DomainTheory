%% Each box is one folder under ContinuousLattice.
%% The arrowhead points at the folder that imports. The label is how many direct imports.
%% FunctionSpaces --> FunctionSpaceTower means the tower imports function spaces.
flowchart TB
  FST["FunctionSpaceTower"]
  IL["InverseLimits"]
  CLAT["ContinuousLattices"]
  FS["FunctionSpaces"]
  CON["Constructions"]
  SM["ScottMaps"]
  INJ["Injective"]
  MC["MilnerCorrection"]
  SP["Specialization"]
  WB["WayBelow"]

  IL -->|"21"| FST
  FS -->|"45"| FST
  SM -->|"3"| FST
  WB -->|"1"| FST
  CLAT -->|"3"| IL
  FS -->|"24"| IL
  CON -->|"2"| IL
  SM -->|"11"| IL
  INJ -->|"1"| IL
  SP -->|"4"| IL
  WB -->|"5"| IL
  FS -->|"5"| CLAT
  CON -->|"8"| CLAT
  INJ -->|"10"| CLAT
  SM -->|"7"| CLAT
  SP -->|"10"| CLAT
  WB -->|"13"| CLAT
  SM -->|"39"| FS
  SP -->|"8"| FS
  WB -->|"64"| FS
  SM -->|"3"| CON
  INJ -->|"3"| CON
  SP -->|"15"| CON
  WB -->|"29"| CON
  SP -->|"7"| SM
  WB -->|"8"| SM
  SP -->|"2"| MC
  WB -->|"1"| MC
  WB -->|"5"| SP

  classDef inj fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
  classDef wb fill:#dcfce7,stroke:#15803d,color:#14532d
  classDef sp fill:#fef3c7,stroke:#b45309,color:#78350f
  classDef sm fill:#fce7f3,stroke:#be185d,color:#831843
  classDef mc fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d
  classDef con fill:#e0e7ff,stroke:#4338ca,color:#312e81
  classDef fs fill:#cffafe,stroke:#0e7490,color:#164e63
  classDef clat fill:#fae8ff,stroke:#a21caf,color:#701a75
  classDef il fill:#ffedd5,stroke:#c2410c,color:#7c2d12
  classDef fst fill:#f3e8ff,stroke:#7e22ce,color:#581c87

  class INJ inj
  class WB wb
  class SP sp
  class SM sm
  class MC mc
  class CON con
  class FS fs
  class CLAT clat
  class IL il
  class FST fst
