%% Each box is one folder under BridgeTheorems. BridgeTheorems is the Lean files in that folder, not in a subfolder.
%% The arrowhead points at the folder that imports. The label is how many direct imports.
flowchart TB
  N0["ContinuousLatticeToNeighborhood"]
  N1["InfoSysConstructions"]
  N2["InfoSysToIdealCompletion"]
  N3["InfoSysToNeighborhood"]
  N4["NeighborhoodToInfoSys"]
  N5["PresentationDomains"]
  N6["BridgeTheorems"]
  N7["WorkedExampleSExpr"]

  N6 -->|"6"| N3
  N6 -->|"7"| N4
  N0 -->|"18"| N5
  N2 -->|"16"| N5
  N3 -->|"14"| N5
  N4 -->|"15"| N5
  N6 -->|"14"| N5
  N0 -->|"1"| N6
  N1 -->|"16"| N6
  N2 -->|"1"| N6
  N3 -->|"1"| N6
  N4 -->|"1"| N6
  N5 -->|"15"| N6
  N1 -->|"16"| N7
  N2 -->|"16"| N7
  N3 -->|"16"| N7
  N5 -->|"16"| N7
  N6 -->|"32"| N7

  classDef c0 fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
